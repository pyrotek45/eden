// Eden DAW — Arrangement view drawing
// Draws the transport bar, loop ruler, timeline, track headers, clips.

use sdl2::rect::Rect;
use sdl2::render::Canvas;
use sdl2::video::Window;

use crate::input::{InputState, WidgetId};
use crate::state::*;
use crate::theme::Theme;
use crate::widgets::*;

// ── Transport bar ────────────────────────────────────────────────────

pub fn draw_transport(
    canvas: &mut Canvas<Window>,
    input: &mut InputState,
    state: &mut AppState,
) {
    let w = state.window_width as i32;
    let h = state.transport_bar_height();

    // Background
    canvas.set_draw_color(Theme::c(state.theme.panel_bg));
    let _ = canvas.fill_rect(Rect::new(0, 0, w as u32, h as u32));

    // Bottom border
    canvas.set_draw_color(Theme::c(state.theme.panel_border));
    let _ = canvas.draw_line(
        sdl2::rect::Point::new(0, h - 1),
        sdl2::rect::Point::new(w, h - 1),
    );

    // Play button
    let play_clicked = button(canvas, input, &state.theme, &ButtonParams {
        id: WidgetId::Button(1),
        x: 10,
        y: 8,
        width: 50,
        height: 30,
        label: "Play".into(),
        toggled: state.project.transport.playing,
    });
    if play_clicked {
        state.project.transport.playing = !state.project.transport.playing;
    }

    // Stop button
    let stop_clicked = button(canvas, input, &state.theme, &ButtonParams {
        id: WidgetId::Button(2),
        x: 65,
        y: 8,
        width: 50,
        height: 30,
        label: "Stop".into(),
        toggled: false,
    });
    if stop_clicked {
        state.project.transport.playing = false;
        state.project.transport.position = 0.0;
    }

    // Record button (placeholder)
    let _rec_clicked = button(canvas, input, &state.theme, &ButtonParams {
        id: WidgetId::Button(3),
        x: 120,
        y: 8,
        width: 40,
        height: 30,
        label: "Rec".into(),
        toggled: state.project.transport.recording,
    });

    // Loop toggle
    let loop_clicked = button(canvas, input, &state.theme, &ButtonParams {
        id: WidgetId::Button(4),
        x: 170,
        y: 8,
        width: 50,
        height: 30,
        label: "Loop".into(),
        toggled: state.project.transport.loop_enabled,
    });
    if loop_clicked {
        state.project.transport.loop_enabled = !state.project.transport.loop_enabled;
    }

    // Tempo display — a small knob
    let bpm = state.project.tempo_map.bpm_at(0.0) as f32;
    let mut bpm_val = bpm;
    let tempo_changed = knob(canvas, input, &state.theme, &KnobParams {
        id: WidgetId::Knob(999),
        x: 260,
        y: 24,
        radius: 16,
        min: 40.0,
        max: 300.0,
        sensitivity: 0.3,
        label: Some("BPM".into()),
    }, &mut bpm_val);
    if tempo_changed {
        if let Some(first) = state.project.tempo_map.changes.first_mut() {
            first.bpm = bpm_val as f64;
        }
    }

    // Position display
    let pos = state.project.transport.position;
    let bar = (pos / 4.0).floor() as i32 + 1;
    let beat = (pos % 4.0).floor() as i32 + 1;

    // Draw position indicator as colored rectangles (placeholder for text)
    canvas.set_draw_color(Theme::c(state.theme.text_primary));
    let px = 310;
    // Bar indicator
    let bar_w = (bar * 4).min(80);
    let _ = canvas.fill_rect(Rect::new(px, 14, bar_w as u32, 4));
    // Beat indicator
    let beat_w = (beat * 10).min(40);
    let _ = canvas.fill_rect(Rect::new(px, 26, beat_w as u32, 4));

    // Theme switch button
    let theme_clicked = button(canvas, input, &state.theme, &ButtonParams {
        id: WidgetId::Button(5),
        x: w - 80,
        y: 8,
        width: 70,
        height: 30,
        label: "Theme".into(),
        toggled: false,
    });
    if theme_clicked {
        state.next_theme();
    }

    // Save button
    let save_clicked = button(canvas, input, &state.theme, &ButtonParams {
        id: WidgetId::Button(6),
        x: w - 160,
        y: 8,
        width: 70,
        height: 30,
        label: "Save".into(),
        toggled: false,
    });
    if save_clicked {
        match state.quick_save() {
            Ok(()) => println!("[save] Project saved"),
            Err(e) => eprintln!("[save] Error: {}", e),
        }
    }

    // Render button
    let render_clicked = button(canvas, input, &state.theme, &ButtonParams {
        id: WidgetId::Button(7),
        x: w - 240,
        y: 8,
        width: 70,
        height: 30,
        label: "Export".into(),
        toggled: false,
    });
    if render_clicked {
        let path = format!("{}.wav", state.project.name);
        match crate::render::render_to_wav(&state.project, &path) {
            Ok(()) => println!("[render] Exported to {}", path),
            Err(e) => eprintln!("[render] Error: {}", e),
        }
    }

    // Undo / Redo buttons
    let undo_clicked = button(canvas, input, &state.theme, &ButtonParams {
        id: WidgetId::Button(8),
        x: w - 340,
        y: 8,
        width: 44,
        height: 30,
        label: "Undo".into(),
        toggled: false,
    });
    if undo_clicked {
        state.commands.undo(&mut state.project);
    }

    let redo_clicked = button(canvas, input, &state.theme, &ButtonParams {
        id: WidgetId::Button(9),
        x: w - 290,
        y: 8,
        width: 44,
        height: 30,
        label: "Redo".into(),
        toggled: false,
    });
    if redo_clicked {
        state.commands.redo(&mut state.project);
    }
}

// ── Loop ruler ───────────────────────────────────────────────────────

pub fn draw_loop_ruler(
    canvas: &mut Canvas<Window>,
    input: &mut InputState,
    state: &mut AppState,
) {
    let y = state.transport_bar_height();
    let h = state.loop_ruler_height();
    let w = state.window_width as i32;
    let header_w = state.arrangement.track_header_width;

    // Background
    canvas.set_draw_color(Theme::c(state.theme.bg_medium));
    let _ = canvas.fill_rect(Rect::new(0, y, w as u32, h as u32));

    // Loop region visualization
    let zoom = state.arrangement.zoom_x;
    let scroll = state.arrangement.scroll_x;
    let loop_start = state.project.transport.loop_region.start;
    let loop_end = state.project.transport.loop_region.end;

    let lx1 = header_w + ((loop_start - scroll) * zoom) as i32;
    let lx2 = header_w + ((loop_end - scroll) * zoom) as i32;

    if state.project.transport.loop_enabled {
        canvas.set_draw_color(Theme::c(state.theme.loop_region));
        let _ = canvas.fill_rect(Rect::new(
            lx1.max(header_w),
            y,
            (lx2 - lx1).max(0) as u32,
            h as u32,
        ));

        // Loop start/end handles
        canvas.set_draw_color(Theme::c(state.theme.loop_color));
        let _ = canvas.fill_rect(Rect::new(lx1, y, 3, h as u32));
        let _ = canvas.fill_rect(Rect::new(lx2 - 3, y, 3, h as u32));
    }

    // Interaction: drag loop region
    let ruler_area = input.mouse_in_rect(header_w, y, w - header_w, h);

    if ruler_area && input.mouse_pressed {
        // Click to set loop start
        let beat = scroll + (input.mouse_x - header_w) as f64 / zoom;
        let beat = (beat * 4.0).round() / 4.0; // snap to 16th
        if input.key_mod.contains(sdl2::keyboard::Mod::LSHIFTMOD) {
            // Shift-click sets loop end
            state.project.transport.loop_region.end = beat.max(state.project.transport.loop_region.start + 0.25);
        } else {
            state.project.transport.loop_region.start = beat.max(0.0);
            if state.project.transport.loop_region.start >= state.project.transport.loop_region.end {
                state.project.transport.loop_region.end = state.project.transport.loop_region.start + 4.0;
            }
        }
    }

    // Border
    canvas.set_draw_color(Theme::c(state.theme.panel_border));
    let _ = canvas.draw_line(
        sdl2::rect::Point::new(0, y + h - 1),
        sdl2::rect::Point::new(w, y + h - 1),
    );
}

// ── Timeline ruler ───────────────────────────────────────────────────

pub fn draw_timeline_ruler(
    canvas: &mut Canvas<Window>,
    input: &mut InputState,
    state: &mut AppState,
) {
    let y = state.transport_bar_height() + state.loop_ruler_height();
    let h = state.timeline_ruler_height();
    let w = state.window_width as i32;
    let header_w = state.arrangement.track_header_width;

    // Background
    canvas.set_draw_color(Theme::c(state.theme.bg_light));
    let _ = canvas.fill_rect(Rect::new(0, y, w as u32, h as u32));

    let zoom = state.arrangement.zoom_x;
    let scroll = state.arrangement.scroll_x;

    // Determine beat spacing
    let beat_px = zoom;
    let _bar_px = beat_px * 4.0;

    // Draw bar/beat markers
    let start_beat = scroll.floor() as i32;
    let end_beat = start_beat + ((w - header_w) as f64 / beat_px) as i32 + 2;

    for beat in start_beat..end_beat {
        if beat < 0 { continue; }
        let x = header_w + ((beat as f64 - scroll) * beat_px) as i32;
        if x < header_w || x > w { continue; }

        if beat % 4 == 0 {
            // Bar line
            canvas.set_draw_color(Theme::c(state.theme.text_secondary));
            let _ = canvas.draw_line(
                sdl2::rect::Point::new(x, y),
                sdl2::rect::Point::new(x, y + h),
            );
            // Bar number indicator (small rectangle)
            canvas.set_draw_color(Theme::c(state.theme.text_primary));
            let bar_num = beat / 4 + 1;
            let bar_w = ((bar_num.to_string().len() as i32) * 6).min(30);
            let _ = canvas.fill_rect(Rect::new(x + 3, y + 2, bar_w as u32, 3));
        } else {
            // Beat tick
            canvas.set_draw_color(Theme::c(state.theme.text_dim));
            let _ = canvas.draw_line(
                sdl2::rect::Point::new(x, y + h / 2),
                sdl2::rect::Point::new(x, y + h),
            );
        }
    }

    // Click on ruler to set playhead
    let ruler_area = input.mouse_in_rect(header_w, y, w - header_w, h);
    if ruler_area && input.mouse_pressed {
        let beat = scroll + (input.mouse_x - header_w) as f64 / zoom;
        state.project.transport.position = beat.max(0.0);
    }

    // Border
    canvas.set_draw_color(Theme::c(state.theme.panel_border));
    let _ = canvas.draw_line(
        sdl2::rect::Point::new(0, y + h - 1),
        sdl2::rect::Point::new(w, y + h - 1),
    );
}

// ── Mode tabs ────────────────────────────────────────────────────────

pub fn draw_mode_tabs(
    canvas: &mut Canvas<Window>,
    input: &mut InputState,
    state: &mut AppState,
) {
    let y = state.transport_bar_height() + state.loop_ruler_height() + state.timeline_ruler_height();
    let h = state.mode_tab_height();
    let w = state.window_width as i32;

    canvas.set_draw_color(Theme::c(state.theme.bg_medium));
    let _ = canvas.fill_rect(Rect::new(0, y, w as u32, h as u32));

    let modes = [
        (AppMode::Arrangement, "Arrange"),
        (AppMode::Mixer, "Mixer"),
        (AppMode::PianoRoll, "Piano Roll"),
        (AppMode::InstrumentRack, "Instruments"),
    ];

    let tab_w = 90;
    for (i, (mode, label)) in modes.iter().enumerate() {
        let tx = 4 + i as i32 * (tab_w + 4);
        let clicked = button(canvas, input, &state.theme, &ButtonParams {
            id: WidgetId::Button(100 + i as u32),
            x: tx,
            y: y + 2,
            width: tab_w,
            height: h - 4,
            label: label.to_string(),
            toggled: state.mode == *mode,
        });
        if clicked {
            state.mode = *mode;
        }
    }

    canvas.set_draw_color(Theme::c(state.theme.panel_border));
    let _ = canvas.draw_line(
        sdl2::rect::Point::new(0, y + h - 1),
        sdl2::rect::Point::new(w, y + h - 1),
    );
}

// ── Track headers ────────────────────────────────────────────────────

pub fn draw_track_headers(
    canvas: &mut Canvas<Window>,
    input: &mut InputState,
    state: &mut AppState,
) {
    let top = state.track_area_top();
    let header_w = state.arrangement.track_header_width;
    let scroll_y = state.arrangement.scroll_y;

    // Background
    canvas.set_draw_color(Theme::c(state.theme.panel_bg));
    let _ = canvas.fill_rect(Rect::new(0, top, header_w as u32, state.track_area_height() as u32));

    let mut y = top - scroll_y;

    // We need to collect track info first to avoid borrow issues
    let track_infos: Vec<(u32, String, i32, f32, f32, bool, bool, [u8; 4])> = state.project.tracks.iter()
        .map(|t| (t.id, t.name.clone(), t.height, t.volume, t.pan, t.mute, t.solo, t.color))
        .collect();

    for (id, name, height, mut volume, mut pan, mute, solo, color) in track_infos {
        if y + height < top { y += height; continue; }
        if y > top + state.track_area_height() { break; }

        let selected = state.selected_track == Some(id);

        // Track header background
        let bg = if selected {
            Theme::c(state.theme.track_selected)
        } else {
            Theme::c(state.theme.track_header)
        };
        canvas.set_draw_color(bg);
        let _ = canvas.fill_rect(Rect::new(0, y, header_w as u32, height as u32));

        // Color strip
        canvas.set_draw_color(sdl2::pixels::Color::RGBA(color[0], color[1], color[2], color[3]));
        let _ = canvas.fill_rect(Rect::new(0, y, 4, height as u32));

        // Click to select track
        if input.mouse_in_rect(0, y, header_w, height) && input.mouse_pressed {
            state.selected_track = Some(id);
        }

        // Track name placeholder (colored bar)
        canvas.set_draw_color(Theme::c(state.theme.text_primary));
        let name_w = (name.len() as i32 * 6).min(header_w - 20);
        let _ = canvas.fill_rect(Rect::new(10, y + 6, name_w as u32, 3));

        // Volume slider (small)
        let vol_changed = slider(canvas, input, &state.theme, &SliderParams {
            id: WidgetId::Slider(id * 10),
            x: 10,
            y: y + 18,
            width: header_w - 60,
            height: 12,
            min: 0.0,
            max: 1.0,
            orientation: SliderOrientation::Horizontal,
            label: None,
        }, &mut volume);
        if vol_changed {
            if let Some(t) = state.project.tracks.iter_mut().find(|t| t.id == id) {
                t.volume = volume;
            }
            state.dirty = true;
        }

        // Pan knob (small)
        let pan_changed = knob(canvas, input, &state.theme, &KnobParams {
            id: WidgetId::Knob(id * 10 + 1),
            x: 10 + header_w - 50,
            y: y + 24,
            radius: 10,
            min: -1.0,
            max: 1.0,
            sensitivity: 0.008,
            label: None,
        }, &mut pan);
        if pan_changed {
            if let Some(t) = state.project.tracks.iter_mut().find(|t| t.id == id) {
                t.pan = pan;
            }
            state.dirty = true;
        }

        // Mute button
        let mute_clicked = toggle_button(
            canvas, input, &state.theme,
            10, y + height - 24, 18,
            state.theme.mute_on, mute,
            WidgetId::Button(id * 10 + 2),
        );
        if mute_clicked {
            if let Some(t) = state.project.tracks.iter_mut().find(|t| t.id == id) {
                t.mute = !t.mute;
            }
        }

        // Solo button
        let solo_clicked = toggle_button(
            canvas, input, &state.theme,
            32, y + height - 24, 18,
            state.theme.solo_on, solo,
            WidgetId::Button(id * 10 + 3),
        );
        if solo_clicked {
            if let Some(t) = state.project.tracks.iter_mut().find(|t| t.id == id) {
                t.solo = !t.solo;
            }
        }

        // Bottom border
        canvas.set_draw_color(Theme::c(state.theme.panel_border));
        let _ = canvas.draw_line(
            sdl2::rect::Point::new(0, y + height - 1),
            sdl2::rect::Point::new(header_w, y + height - 1),
        );

        y += height;
    }

    // Right border of header area
    canvas.set_draw_color(Theme::c(state.theme.panel_border));
    let _ = canvas.draw_line(
        sdl2::rect::Point::new(header_w - 1, top),
        sdl2::rect::Point::new(header_w - 1, top + state.track_area_height()),
    );
}

// ── Track lanes + clips ──────────────────────────────────────────────

pub fn draw_track_lanes(
    canvas: &mut Canvas<Window>,
    input: &mut InputState,
    state: &mut AppState,
) {
    let top = state.track_area_top();
    let header_w = state.arrangement.track_header_width;
    let w = state.window_width as i32;
    let scroll_x = state.arrangement.scroll_x;
    let scroll_y = state.arrangement.scroll_y;
    let zoom = state.arrangement.zoom_x;
    let lane_area_w = w - header_w;

    // Background
    canvas.set_draw_color(Theme::c(state.theme.bg_dark));
    let _ = canvas.fill_rect(Rect::new(header_w, top, lane_area_w as u32, state.track_area_height() as u32));

    // Grid lines (vertical — beats / bars)
    let beat_px = zoom;
    let start_beat = scroll_x.floor() as i32;
    let end_beat = start_beat + (lane_area_w as f64 / beat_px) as i32 + 2;

    for beat in start_beat..end_beat {
        if beat < 0 { continue; }
        let x = header_w + ((beat as f64 - scroll_x) * beat_px) as i32;
        if x < header_w || x > w { continue; }

        let color = if beat % 4 == 0 {
            Theme::c(state.theme.grid_line_strong)
        } else {
            Theme::c(state.theme.grid_line)
        };
        canvas.set_draw_color(color);
        let _ = canvas.draw_line(
            sdl2::rect::Point::new(x, top),
            sdl2::rect::Point::new(x, top + state.track_area_height()),
        );
    }

    // Track lanes + clips
    let mut y = top - scroll_y;

    let track_count = state.project.tracks.len();
    for track_idx in 0..track_count {
        let track_height = state.project.tracks[track_idx].height;
        let track_id = state.project.tracks[track_idx].id;

        if y + track_height < top { y += track_height; continue; }
        if y > top + state.track_area_height() { break; }

        // Alternate track background
        if track_idx % 2 == 1 {
            canvas.set_draw_color(Theme::c(state.theme.track_bg_alt));
            let _ = canvas.fill_rect(Rect::new(header_w, y, lane_area_w as u32, track_height as u32));
        }

        // Draw clips
        let clip_count = state.project.tracks[track_idx].clips.len();
        for ci in 0..clip_count {
            let clip_start = state.project.tracks[track_idx].clips[ci].start_time();
            let clip_len = state.project.tracks[track_idx].clips[ci].length();
            let clip_color = state.project.tracks[track_idx].clips[ci].color();

            let cx = header_w + ((clip_start - scroll_x) * zoom) as i32;
            let cw = (clip_len * zoom) as i32;

            if cx + cw < header_w || cx > w { continue; }

            // Clip body
            canvas.set_draw_color(sdl2::pixels::Color::RGBA(
                clip_color[0], clip_color[1], clip_color[2], clip_color[3],
            ));
            let clip_y = y + 2;
            let clip_h = (track_height - 4) as u32;
            let _ = canvas.fill_rect(Rect::new(cx, clip_y, cw.max(4) as u32, clip_h));

            // Clip border
            let is_selected = state.selected_clip == Some((track_id, ci));
            if is_selected {
                canvas.set_draw_color(Theme::c(state.theme.accent));
            } else {
                canvas.set_draw_color(sdl2::pixels::Color::RGBA(
                    clip_color[0].saturating_add(30),
                    clip_color[1].saturating_add(30),
                    clip_color[2].saturating_add(30),
                    255,
                ));
            }
            let _ = canvas.draw_rect(Rect::new(cx, clip_y, cw.max(4) as u32, clip_h));

            // Clip name placeholder
            canvas.set_draw_color(Theme::c(state.theme.text_primary));
            let name = state.project.tracks[track_idx].clips[ci].name();
            let name_w = (name.len() as i32 * 5).min(cw - 6);
            if name_w > 0 {
                let _ = canvas.fill_rect(Rect::new(cx + 4, clip_y + 4, name_w as u32, 2));
            }

            // Draw mini note preview for MIDI clips
            if let crate::models::Clip::Midi(ref midi) = state.project.tracks[track_idx].clips[ci] {
                for note in &midi.notes {
                    let nx = cx + ((note.start / clip_len) * cw as f64) as i32;
                    let nw = ((note.length / clip_len) * cw as f64) as i32;
                    let pitch_t = note.pitch as f32 / 127.0;
                    let ny = clip_y + clip_h as i32 - (pitch_t * clip_h as f32) as i32 - 2;
                    canvas.set_draw_color(Theme::c(state.theme.text_primary));
                    let _ = canvas.fill_rect(Rect::new(nx, ny, nw.max(2) as u32, 2));
                }
            }

            // Click to select clip
            if input.mouse_in_rect(cx, clip_y, cw.max(4), clip_h as i32) && input.mouse_pressed {
                state.selected_clip = Some((track_id, ci));
                state.selected_track = Some(track_id);
            }
        }

        // Horizontal lane separator
        canvas.set_draw_color(Theme::c(state.theme.grid_line));
        let _ = canvas.draw_line(
            sdl2::rect::Point::new(header_w, y + track_height - 1),
            sdl2::rect::Point::new(w, y + track_height - 1),
        );

        y += track_height;
    }

    // ── Playhead ──
    let playhead_beat = state.project.transport.position;
    let px = header_w + ((playhead_beat - scroll_x) * zoom) as i32;
    if px >= header_w && px <= w {
        canvas.set_draw_color(Theme::c(state.theme.playhead));
        let _ = canvas.draw_line(
            sdl2::rect::Point::new(px, top),
            sdl2::rect::Point::new(px, top + state.track_area_height()),
        );
        // Playhead triangle at top
        let _ = canvas.fill_rect(Rect::new(px - 4, top, 8, 4));
    }

    // ── Scroll with mouse wheel ──
    if input.mouse_in_rect(header_w, top, lane_area_w, state.track_area_height()) {
        if input.scroll_y != 0 {
            if input.key_mod.contains(sdl2::keyboard::Mod::LCTRLMOD)
                || input.key_mod.contains(sdl2::keyboard::Mod::RCTRLMOD)
            {
                // Ctrl+scroll = zoom
                let factor = if input.scroll_y > 0 { 1.15 } else { 0.87 };
                state.arrangement.zoom_x = (state.arrangement.zoom_x * factor).clamp(5.0, 200.0);
            } else {
                // Scroll = vertical scroll
                state.arrangement.scroll_y = (state.arrangement.scroll_y - input.scroll_y * 30).max(0);
            }
        }
        if input.scroll_x != 0 {
            state.arrangement.scroll_x = (state.arrangement.scroll_x - input.scroll_x as f64 * 2.0).max(0.0);
        }
    }

    // Middle mouse drag to pan
    if input.middle_mouse_down && input.mouse_in_rect(header_w, top, lane_area_w, state.track_area_height()) {
        state.arrangement.scroll_x = (state.arrangement.scroll_x - input.mouse_dx as f64 / zoom).max(0.0);
        state.arrangement.scroll_y = (state.arrangement.scroll_y - input.mouse_dy).max(0);
    }
}

// ── Full arrangement draw ────────────────────────────────────────────

pub fn draw_arrangement(
    canvas: &mut Canvas<Window>,
    input: &mut InputState,
    state: &mut AppState,
) {
    draw_transport(canvas, input, state);
    draw_loop_ruler(canvas, input, state);
    draw_timeline_ruler(canvas, input, state);
    draw_mode_tabs(canvas, input, state);
    draw_track_headers(canvas, input, state);
    draw_track_lanes(canvas, input, state);
}

// ── Mixer view (stub) ────────────────────────────────────────────────

pub fn draw_mixer(
    canvas: &mut Canvas<Window>,
    input: &mut InputState,
    state: &mut AppState,
) {
    draw_transport(canvas, input, state);
    draw_mode_tabs(canvas, input, state);

    let top = state.transport_bar_height() + state.mode_tab_height();
    let w = state.window_width as i32;
    let h = state.window_height as i32 - top;

    canvas.set_draw_color(Theme::c(state.theme.bg_dark));
    let _ = canvas.fill_rect(Rect::new(0, top, w as u32, h as u32));

    // Draw channel strips
    let strip_w = 80;
    let track_count = state.project.tracks.len();

    for i in 0..track_count {
        let x = 10 + i as i32 * (strip_w + 6);
        let sy = top + 10;
        let sh = h - 20;

        let track_id = state.project.tracks[i].id;
        let track_color = state.project.tracks[i].color;

        // Strip background
        canvas.set_draw_color(Theme::c(state.theme.panel_bg));
        let _ = canvas.fill_rect(Rect::new(x, sy, strip_w as u32, sh as u32));

        // Color header
        canvas.set_draw_color(sdl2::pixels::Color::RGBA(
            track_color[0], track_color[1], track_color[2], track_color[3],
        ));
        let _ = canvas.fill_rect(Rect::new(x, sy, strip_w as u32, 6));

        // Volume fader (vertical)
        let mut vol = state.project.tracks[i].volume;
        let vol_changed = slider(canvas, input, &state.theme, &SliderParams {
            id: WidgetId::Slider(track_id * 100),
            x: x + 25,
            y: sy + 30,
            width: 30,
            height: sh - 120,
            min: 0.0,
            max: 1.0,
            orientation: SliderOrientation::Vertical,
            label: None,
        }, &mut vol);
        if vol_changed {
            state.project.tracks[i].volume = vol;
        }

        // Pan knob
        let mut pan_val = state.project.tracks[i].pan;
        let pan_changed = knob(canvas, input, &state.theme, &KnobParams {
            id: WidgetId::Knob(track_id * 100 + 1),
            x: x + strip_w / 2,
            y: sy + sh - 60,
            radius: 14,
            min: -1.0,
            max: 1.0,
            sensitivity: 0.008,
            label: None,
        }, &mut pan_val);
        if pan_changed {
            state.project.tracks[i].pan = pan_val;
        }

        // Mute / Solo
        let mute_on = state.project.tracks[i].mute;
        let solo_on = state.project.tracks[i].solo;

        let mute_clicked = toggle_button(
            canvas, input, &state.theme,
            x + 8, sy + sh - 28, 18,
            state.theme.mute_on, mute_on,
            WidgetId::Button(track_id * 100 + 2),
        );
        if mute_clicked {
            state.project.tracks[i].mute = !state.project.tracks[i].mute;
        }

        let solo_clicked = toggle_button(
            canvas, input, &state.theme,
            x + 30, sy + sh - 28, 18,
            state.theme.solo_on, solo_on,
            WidgetId::Button(track_id * 100 + 3),
        );
        if solo_clicked {
            state.project.tracks[i].solo = !state.project.tracks[i].solo;
        }

        // Border
        canvas.set_draw_color(Theme::c(state.theme.panel_border));
        let _ = canvas.draw_rect(Rect::new(x, sy, strip_w as u32, sh as u32));
    }
}

// ── Piano Roll view (stub) ───────────────────────────────────────────

pub fn draw_piano_roll(
    canvas: &mut Canvas<Window>,
    input: &mut InputState,
    state: &mut AppState,
) {
    draw_transport(canvas, input, state);
    draw_mode_tabs(canvas, input, state);

    let top = state.transport_bar_height() + state.mode_tab_height();
    let w = state.window_width as i32;
    let h = state.window_height as i32 - top;
    let key_w = 50;

    canvas.set_draw_color(Theme::c(state.theme.bg_dark));
    let _ = canvas.fill_rect(Rect::new(0, top, w as u32, h as u32));

    // Piano keys
    let note_h = 10;
    let visible_notes = h / note_h;
    let base_note: i32 = 48; // C3

    for i in 0..visible_notes {
        let note = base_note + (visible_notes - i - 1);
        let ny = top + i * note_h;

        let is_black = matches!(note % 12, 1 | 3 | 6 | 8 | 10);
        let key_color = if is_black {
            Theme::c(state.theme.piano_black_key)
        } else {
            Theme::c(state.theme.piano_white_key)
        };

        canvas.set_draw_color(key_color);
        let _ = canvas.fill_rect(Rect::new(0, ny, key_w as u32, note_h as u32));

        canvas.set_draw_color(Theme::c(state.theme.grid_line));
        let _ = canvas.draw_line(
            sdl2::rect::Point::new(0, ny + note_h - 1),
            sdl2::rect::Point::new(w, ny + note_h - 1),
        );

        // Grid area
        if is_black {
            canvas.set_draw_color(sdl2::pixels::Color::RGBA(0, 0, 0, 20));
            let _ = canvas.fill_rect(Rect::new(key_w, ny, (w - key_w) as u32, note_h as u32));
        }
    }

    // Beat grid
    let zoom = state.arrangement.zoom_x;
    let scroll = state.arrangement.scroll_x;
    let start_beat = scroll.floor() as i32;
    let end_beat = start_beat + ((w - key_w) as f64 / zoom) as i32 + 2;

    for beat in start_beat..end_beat {
        if beat < 0 { continue; }
        let x = key_w + ((beat as f64 - scroll) * zoom) as i32;
        if x < key_w || x > w { continue; }

        let color = if beat % 4 == 0 {
            Theme::c(state.theme.grid_line_strong)
        } else {
            Theme::c(state.theme.grid_line)
        };
        canvas.set_draw_color(color);
        let _ = canvas.draw_line(
            sdl2::rect::Point::new(x, top),
            sdl2::rect::Point::new(x, top + h),
        );
    }

    // Draw notes from selected clip
    if let Some((track_id, clip_idx)) = state.selected_clip {
        if let Some(track) = state.project.tracks.iter().find(|t| t.id == track_id) {
            if let Some(crate::models::Clip::Midi(midi)) = track.clips.get(clip_idx) {
                for note in &midi.notes {
                    let nx = key_w + ((midi.start_time + note.start - scroll) * zoom) as i32;
                    let nw = (note.length * zoom) as i32;
                    let note_offset = note.pitch as i32 - base_note;
                    let ny = top + (visible_notes - 1 - note_offset) * note_h;

                    if ny >= top && ny < top + h {
                        canvas.set_draw_color(Theme::c(state.theme.note_on));
                        let _ = canvas.fill_rect(Rect::new(nx, ny, nw.max(4) as u32, (note_h - 1) as u32));
                        canvas.set_draw_color(Theme::c(state.theme.accent));
                        let _ = canvas.draw_rect(Rect::new(nx, ny, nw.max(4) as u32, (note_h - 1) as u32));
                    }
                }
            }
        }
    }

    // Piano key border
    canvas.set_draw_color(Theme::c(state.theme.panel_border));
    let _ = canvas.draw_line(
        sdl2::rect::Point::new(key_w - 1, top),
        sdl2::rect::Point::new(key_w - 1, top + h),
    );
}

// ── Instrument rack view (stub) ──────────────────────────────────────

pub fn draw_instrument_rack(
    canvas: &mut Canvas<Window>,
    input: &mut InputState,
    state: &mut AppState,
) {
    draw_transport(canvas, input, state);
    draw_mode_tabs(canvas, input, state);

    let top = state.transport_bar_height() + state.mode_tab_height();
    let w = state.window_width as i32;
    let h = state.window_height as i32 - top;

    canvas.set_draw_color(Theme::c(state.theme.bg_dark));
    let _ = canvas.fill_rect(Rect::new(0, top, w as u32, h as u32));

    // Placeholder text
    canvas.set_draw_color(Theme::c(state.theme.text_dim));
    let _ = canvas.fill_rect(Rect::new(w / 2 - 80, top + h / 2 - 5, 160, 3));
}
