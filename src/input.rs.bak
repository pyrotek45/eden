// Eden DAW — Input system
// Tracks mouse state, keyboard modifiers, active widget, drag state.

use sdl2::keyboard::Mod;

/// Unique identifier for a widget so we know what's being dragged.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub enum WidgetId {
    None,
    Knob(u32),         // parameter id
    Slider(u32),       // parameter id
    Button(u32),       // button id
    TrackHeader(u32),  // track id
    Clip(u32, usize),  // track id, clip index
    LoopStart,
    LoopEnd,
    LoopBar,
    Playhead,
    TimelineScroll,
    Custom(u32),
}

/// What kind of click was it?
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum ClickType {
    Single,
    Double,
    RightClick,
}

#[derive(Debug, Clone)]
pub struct InputState {
    // Mouse
    pub mouse_x: i32,
    pub mouse_y: i32,
    pub mouse_prev_x: i32,
    pub mouse_prev_y: i32,
    pub mouse_dx: i32,
    pub mouse_dy: i32,
    pub mouse_down: bool,
    pub mouse_pressed: bool,   // just pressed this frame
    pub mouse_released: bool,  // just released this frame
    pub right_mouse_down: bool,
    pub right_mouse_pressed: bool,
    pub right_mouse_released: bool,
    pub middle_mouse_down: bool,
    pub scroll_x: i32,
    pub scroll_y: i32,

    // Click detection
    pub click_type: Option<ClickType>,
    pub last_click_time: u64,    // ms
    pub last_click_pos: (i32, i32),
    pub double_click_threshold: u64, // ms

    // Drag state
    pub dragging: bool,
    pub drag_start_x: i32,
    pub drag_start_y: i32,
    pub drag_widget: WidgetId,
    pub drag_start_value: f64,  // value at start of drag (for continuous controls)

    // Active / Hot widget
    pub active_widget: WidgetId,
    pub hot_widget: WidgetId,

    // Keyboard
    pub key_mod: Mod,
    pub keys_pressed: Vec<sdl2::keyboard::Keycode>,
}

impl Default for InputState {
    fn default() -> Self {
        Self {
            mouse_x: 0,
            mouse_y: 0,
            mouse_prev_x: 0,
            mouse_prev_y: 0,
            mouse_dx: 0,
            mouse_dy: 0,
            mouse_down: false,
            mouse_pressed: false,
            mouse_released: false,
            right_mouse_down: false,
            right_mouse_pressed: false,
            right_mouse_released: false,
            middle_mouse_down: false,
            scroll_x: 0,
            scroll_y: 0,
            click_type: None,
            last_click_time: 0,
            last_click_pos: (0, 0),
            double_click_threshold: 300,
            dragging: false,
            drag_start_x: 0,
            drag_start_y: 0,
            drag_widget: WidgetId::None,
            drag_start_value: 0.0,
            active_widget: WidgetId::None,
            hot_widget: WidgetId::None,
            key_mod: Mod::empty(),
            keys_pressed: Vec::new(),
        }
    }
}

impl InputState {
    /// Call at the start of each frame, before processing SDL events.
    pub fn begin_frame(&mut self) {
        self.mouse_prev_x = self.mouse_x;
        self.mouse_prev_y = self.mouse_y;
        self.mouse_pressed = false;
        self.mouse_released = false;
        self.right_mouse_pressed = false;
        self.right_mouse_released = false;
        self.scroll_x = 0;
        self.scroll_y = 0;
        self.click_type = None;
        self.keys_pressed.clear();
        self.hot_widget = WidgetId::None;
    }

    /// Call after processing all SDL events for this frame.
    pub fn end_frame(&mut self) {
        self.mouse_dx = self.mouse_x - self.mouse_prev_x;
        self.mouse_dy = self.mouse_y - self.mouse_prev_y;

        // Detect drag start
        if self.mouse_down && !self.dragging {
            let dx = (self.mouse_x - self.drag_start_x).abs();
            let dy = (self.mouse_y - self.drag_start_y).abs();
            if dx > 3 || dy > 3 {
                self.dragging = true;
            }
        }

        // End drag
        if self.mouse_released {
            self.dragging = false;
            self.drag_widget = WidgetId::None;
            self.active_widget = WidgetId::None;
        }
    }

    /// Process an SDL mouse button down event.
    pub fn on_mouse_down(&mut self, x: i32, y: i32, button: sdl2::mouse::MouseButton, ticks: u64) {
        self.mouse_x = x;
        self.mouse_y = y;

        match button {
            sdl2::mouse::MouseButton::Left => {
                self.mouse_down = true;
                self.mouse_pressed = true;
                self.drag_start_x = x;
                self.drag_start_y = y;

                // Detect double click
                let dt = ticks.saturating_sub(self.last_click_time);
                let dist = ((x - self.last_click_pos.0).abs() + (y - self.last_click_pos.1).abs()) as u64;
                if dt < self.double_click_threshold && dist < 10 {
                    self.click_type = Some(ClickType::Double);
                } else {
                    self.click_type = Some(ClickType::Single);
                }
                self.last_click_time = ticks;
                self.last_click_pos = (x, y);
            }
            sdl2::mouse::MouseButton::Right => {
                self.right_mouse_down = true;
                self.right_mouse_pressed = true;
                self.click_type = Some(ClickType::RightClick);
            }
            sdl2::mouse::MouseButton::Middle => {
                self.middle_mouse_down = true;
            }
            _ => {}
        }
    }

    /// Process an SDL mouse button up event.
    pub fn on_mouse_up(&mut self, x: i32, y: i32, button: sdl2::mouse::MouseButton) {
        self.mouse_x = x;
        self.mouse_y = y;
        match button {
            sdl2::mouse::MouseButton::Left => {
                self.mouse_down = false;
                self.mouse_released = true;
            }
            sdl2::mouse::MouseButton::Right => {
                self.right_mouse_down = false;
                self.right_mouse_released = true;
            }
            sdl2::mouse::MouseButton::Middle => {
                self.middle_mouse_down = false;
            }
            _ => {}
        }
    }

    pub fn on_mouse_move(&mut self, x: i32, y: i32) {
        self.mouse_x = x;
        self.mouse_y = y;
    }

    pub fn on_scroll(&mut self, x: i32, y: i32) {
        self.scroll_x = x;
        self.scroll_y = y;
    }

    /// Check if mouse is inside a rectangle.
    pub fn mouse_in_rect(&self, x: i32, y: i32, w: i32, h: i32) -> bool {
        self.mouse_x >= x && self.mouse_x < x + w && self.mouse_y >= y && self.mouse_y < y + h
    }
}
